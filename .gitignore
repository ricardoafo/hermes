# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
coverage.json
coverage.xml
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/
.hypothesis/

# Environment / secrets
.env
.env.local
*.pem
*.key

# Local dev state — DB, logs, backups. Never commit runtime state.
# Real data lives on the VPS at /var/lib/hermes/ (per ADR-003 §09).
# Migration schema lives in src/hermes/migrations/ (committed).
*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm
*.db-journal
*.log
var/

# OS
.DS_Store
Thumbs.db

# Editors (root-level; .idea handles itself internally)
*.swp
*.swo
.vscode/
.idea/

# Sub-agent worktree scratch and personal settings (never commit). The shared
# skills and hooks are kept (#847).
.claude/*
!.claude/skills/
!.claude/settings.json

# Real taxpayer profile must never be committed (ADR-016 decision 12).
# Default location is ~/.config/hermes/taxpayer.yaml, outside the repo; these
# patterns catch a copy dropped inside the tree. The zeros-only example is allowed.
taxpayer.yaml
**/taxpayer.yaml
.config/hermes/

# Advisory lock files next to the ledger and the hash-chained logs (#855)
*.serve.lock
*.jsonl.lock

# PR body scratchpads belong outside the tree; at the root they fail
# markdownlint MD041 (a PR body opens with `## Summary`, not an H1).
/pr-body-*.md
/.pr-body-*.md
/*.pr-body.md
