# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
coverage.json
coverage.xml
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/
.hypothesis/

# Environment / secrets
.env
.env.local
*.pem
*.key

# Local dev state — DB, logs, backups. Never commit runtime state.
# Real data lives on the VPS at /var/lib/hermes/ (per ADR-003 §09).
# Migration schema lives in src/hermes/migrations/ (committed).
*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm
*.db-journal
*.log
var/

# OS
.DS_Store
Thumbs.db

# Editors (root-level; .idea handles itself internally)
*.swp
*.swo
.vscode/
.idea/

# Sub-agent worktree scratch (never commit)
.claude/

# Real taxpayer profile must never be committed (ADR-016 decision 12).
# Default location is ~/.config/hermes/taxpayer.yaml, outside the repo; these
# patterns catch a copy dropped inside the tree. The zeros-only example is allowed.
taxpayer.yaml
**/taxpayer.yaml
.config/hermes/

# Advisory lock files next to the ledger and the hash-chained logs (#855)
*.serve.lock
*.jsonl.lock
