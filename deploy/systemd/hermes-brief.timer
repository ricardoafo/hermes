# Fire hermes-brief.service once a day at 07:15 Madrid time (#897).
#
# After the 07:00 alive line and before the 07:30 tax pack refresh, so the
# three never overlap. The time zone follows the CET/CEST switch on its own.
# Installed by vps-bootstrap and left off: enable it with
# `systemctl enable --now hermes-brief.timer`.

[Unit]
Description=Fire hermes-brief at 07:15 Europe/Madrid
Requires=hermes-brief.service

[Timer]
OnCalendar=*-*-* 07:15:00 Europe/Madrid
# Run a missed day on next boot.
Persistent=true
RandomizedDelaySec=60
Unit=hermes-brief.service

[Install]
WantedBy=timers.target
