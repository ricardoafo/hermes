# Prod systemd unit for the hermes main process (`hermes serve`).
#
# Installed to /etc/systemd/system/hermes.service by the CD deploy.
# Layout this unit assumes (see openspec/changes/306-serve-systemd-boot):
#   /opt/hermes/current            -> versions/<version>  (atomic symlink)
#   /opt/hermes/current/.venv      per-release virtualenv (console script `hermes`)
#   /opt/hermes/current/config     per-release non-secret YAML
#   /etc/hermes/env.production     secrets only
#   /var/lib/hermes                state: hermes.sqlite3 and its journal files
#
# See docs/decisions/2026-08-23-credential-storage-layered-by-env.md
# for the three-tier credential story (dotenv, GH Secrets, systemd).

[Unit]
Description=Hermes trading engine (hermes serve)
After=network-online.target
Wants=network-online.target
# Crash-loop guard: at most 5 starts in 10 min, then the unit stays failed.
# Each start re-fetches warm-up history, so an endless loop would hammer the
# market-data API. 5 x RestartSec (30s) = 150s, well inside the 10 min window.
StartLimitIntervalSec=10min
StartLimitBurst=5
# One Telegram message when the unit lands in `failed`: the start limit tripped
# or it exited 2/3. A crash that is about to be restarted does not count; the
# unit is "activating (auto-restart)", not failed. The missed healthchecks.io
# ping (hermes-health.service) covers every other way of being down.
# %N (the name without ".service") keeps the instance unit readable:
# hermes-notify-failure@hermes.service, not @hermes.service.service.
OnFailure=hermes-notify-failure@%N.service

[Service]
Type=simple
User=hermes
Group=hermes

# State dir: systemd creates it (hermes:hermes 0750) before the sandbox is
# built, so ProtectSystem=strict cannot fail on a missing path (226/NAMESPACE).
StateDirectory=hermes
StateDirectoryMode=0750
# CWD is the writable dir, so any relative path lands in state, not in the
# read-only release.
WorkingDirectory=/var/lib/hermes

# The prod tier even when the env file forgets HERMES_ENV: without it serve
# runs as dev and skips the check that prod has a Telegram or Slack channel
# (#856). A value in the env file below still wins.
Environment=HERMES_ENV=prod

# Secrets only. systemd reads this file as root before dropping to User=hermes.
# No leading "-": a missing file must fail the start, not boot without secrets.
EnvironmentFile=/etc/hermes/env.production

ExecStart=/opt/hermes/current/.venv/bin/hermes serve --config-dir /opt/hermes/current/config --db /var/lib/hermes/hermes.sqlite3
Restart=on-failure
RestartSec=30s
# Exit 2 (bad arguments) and 3 (config load failed) never fix themselves.
# Stay failed so `systemctl is-active` and the journal show it.
RestartPreventExitStatus=2 3
# One Slack line after a stop that was not clean (crash, signal, timeout),
# including the ones Restart= recovers from in 30s, which OnFailure= never
# sees (#380). "+" runs it as root outside the sandbox so it can read the
# journal for the last serve.run.failed line; the script is root-owned in
# /opt/hermes/bin, needs only bash and curl, and always exits 0. "-" keeps a
# failed notice from ever changing the stop result.
ExecStopPost=-+/bin/bash /opt/hermes/bin/hermes-notify-crash.sh %n

# Hardening: same pattern as the other hermes units.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# Hides /root and /home. The venv python links into /opt/hermes/python, so it
# stays readable.
ProtectHome=true
ReadWritePaths=/var/lib/hermes

[Install]
WantedBy=multi-user.target
