# Dead-man's-switch ping for hermes.service.
#
# Fired every 5 minutes by hermes-health.timer. The script pings
# healthchecks.io only while `systemctl is-active --quiet hermes.service`
# succeeds, and sends a /fail ping when `hermes status --json` says a check
# is late or hermes is down. A missed or failed ping makes the check's
# Telegram integration alert the operator (deploy/README.md, "Alerting when
# hermes is down").
#
# The script ships inside each release, so ExecStart follows the `current`
# symlink. The ping URL (HERMES_HEALTHCHECKS__PING_URL) comes from the same
# env file as the engine's secrets.

[Unit]
Description=Hermes liveness ping (healthchecks.io, only while hermes.service is active)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=hermes
Group=hermes

# Read by systemd as root before dropping to User=hermes. No leading "-": a
# missing file must fail the ping, not silently skip it.
EnvironmentFile=/etc/hermes/env.production
ExecStart=/bin/bash /opt/hermes/current/deploy/hermes-health-ping.sh

# Hardening — matches the pattern used by real hermes services (ADR-003 §09)
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
CapabilityBoundingSet=
ReadWritePaths=
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0027
