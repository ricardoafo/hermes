# Placeholder health-ping service.
#
# Exists so the CD pipeline has something to `systemctl restart` and
# something to poll for post-deploy verification, before Phase 0 lands
# real hermes processes.
#
# Once Phase 0 adds `hermes-rebalancer.service` etc., this unit stays
# useful as a tiny liveness check that pings healthchecks.io on a
# schedule — orthogonal to the real workload.

[Unit]
Description=Hermes health ping (placeholder pre-Phase-0)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=hermes
Group=hermes

# TODO(phase-0): swap for a real ping command run from
# `/opt/hermes/current/.venv/bin/hermes` once one exists. For now, a shell
# one-liner emits a version marker + ping so journalctl and healthchecks.io
# both see life signs.
ExecStart=/bin/bash -c 'echo "hermes-health tick: $(date -Iseconds) build=${HERMES_BUILD_SHA:-unknown}" && \
                        curl -fsS -m 10 --retry 3 -o /dev/null "${HEALTHCHECK_URL:-https://hc-ping.com/00000000-0000-0000-0000-000000000000}" || true'

# Hardening — matches the pattern used by real hermes services (ADR-003 §09)
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
CapabilityBoundingSet=
ReadWritePaths=

# Populated at install time by deploy/README instructions.
# Environment=HERMES_BUILD_SHA=<sha>
# Environment=HEALTHCHECK_URL=https://hc-ping.com/<uuid>

[Install]
WantedBy=multi-user.target
