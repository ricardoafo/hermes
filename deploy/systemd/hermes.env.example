# ============================================================
# /etc/hermes.env — production env file loaded by systemd
# ============================================================
# Copy this to /etc/hermes.env on the VPS, populate with real
# secrets, then chmod 0600 + chown root:root.
#
#   sudo install -o root -g root -m 0600 hermes.env.example /etc/hermes.env
#   sudo $EDITOR /etc/hermes.env
#
# NEVER commit real secrets to git — this file only exists to
# document the SHAPE that /etc/hermes.env must have. The prod
# systemd unit (deploy/systemd/hermes.service) references
# EnvironmentFile=/etc/hermes.env.
#
# See docs/decisions/2026-08-23-credential-storage-layered-by-env.md
# for the three-tier credential story.

# --- Core (runtime tier gates) ---
# Prod is the only tier where mainnet endpoints are allowed. Any
# other value here makes HERMES_ALLOW_MAINNET=yes a config-load
# error, blocking startup.
HERMES_ENV=prod
# Flip to `yes` ONLY when the operator has consciously reviewed
# every adapter about to touch real capital. Setting this in dev
# or sandbox raises a validation error at process start.
HERMES_ALLOW_MAINNET=yes

# --- Telegram (urgent alerts channel) ---
HERMES_TELEGRAM__BOT_TOKEN=REPLACE_ME_prod_bot_token
HERMES_TELEGRAM__CHAT_ID=REPLACE_ME_prod_chat_id

# --- Slack (rich reports channel) ---
HERMES_SLACK__BOT_TOKEN=xoxb-REPLACE_ME_prod_slack_bot_token
HERMES_SLACK__DEFAULT_CHANNEL=#hermes-reports

# --- Binance (MAINNET — requires HERMES_ALLOW_MAINNET=yes above) ---
HERMES_BINANCE__API_KEY=REPLACE_ME_mainnet_api_key
HERMES_BINANCE__API_SECRET=REPLACE_ME_mainnet_api_secret
# Mainnet endpoints (uncomment to override the YAML default).
# HERMES_BINANCE__BASE_URL=https://api.binance.com
# HERMES_BINANCE__WS_URL=wss://stream.binance.com:9443/ws
# HERMES_BINANCE__TESTNET=false

# --- Kraken (planned — mainnet only in prod) ---
# HERMES_KRAKEN__API_KEY=REPLACE_ME_kraken_api_key
# HERMES_KRAKEN__API_SECRET=REPLACE_ME_kraken_private_key

# --- Frankfurter (FX rates — public, no key required) ---
# HERMES_FRANKFURTER__BASE_URL=https://api.frankfurter.app

# --- Healthchecks.io (dead-man's-switch ping) ---
HERMES_HEALTHCHECKS__PING_URL=https://hc-ping.com/REPLACE_ME_prod_uuid

# --- Sentry (error reporting) ---
# HERMES_SENTRY__DSN=https://REPLACE_ME@sentry.example.com/1
# HERMES_SENTRY__ENVIRONMENT=prod

# --- LLM supervisor (ADR-001 + ADR-005 — supervision only) ---
# HERMES_ML__API_KEY=REPLACE_ME_llm_api_key

# --- Backup (Hetzner Storage Box → borg) ---
# Storage Box in Falkenstein, same DC as hermes-01 for low-latency backups.
# See deploy/hetzner-storagebox-setup.md for one-time repo init.
HERMES_BACKUP_BORG_REPO=ssh://u656997@u656997.your-storagebox.de:23/./hermes-backup
HERMES_BACKUP_SSH_PORT=23
# BORG_PASSPHRASE generated at first `hermes-backup.sh --init`. Save to
# password manager; losing it means backups are unrecoverable.
BORG_PASSPHRASE=REPLACE_ME_borg_passphrase
# Healthchecks.io endpoint for nightly backup dead-man's-switch (optional).
# HERMES_BACKUP_HEALTHCHECK_URL=https://hc-ping.com/REPLACE_ME_backup_uuid
