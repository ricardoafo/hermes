# ============================================================
# /etc/hermes/env.production: production env file loaded by systemd
# ============================================================
# Documents the SHAPE of the file only. The vps-bootstrap workflow renders
# the real file from the GitHub `prod` environment
# (scripts/deploy/vps_bootstrap.sh), once: a re-dispatch leaves an
# existing file alone. To rotate a secret, edit the file on the VPS, or
# delete it and re-dispatch.
# NEVER commit real secrets.
#
# The file must be root:root 0600. systemd reads it as root and hands
# the values to the service; the hermes user never reads the file.
#
# A unit test loads every active line below through the real config
# loader (tests/unit/deploy/test_hermes_env_example.py). Keep the
# names valid: an unknown HERMES_<SECTION>__<FIELD> name makes
# `hermes serve` exit 3 at start.
#
# See docs/decisions/2026-08-23-credential-storage-layered-by-env.md
# for the three-tier credential story.

# --- Core (runtime tier gates) ---
# MVP1 is paper trading on live market data. `prod` is the tier this
# host runs in; HERMES_ALLOW_MAINNET=no keeps every real-money path
# closed. Do NOT set it to `yes` before the MVP2 sign-off.
HERMES_ENV="prod"
HERMES_ALLOW_MAINNET="no"

# --- Telegram (urgent alerts channel) ---
# Also read by deploy/hermes-notify-failure.sh (the OnFailure= alert for
# hermes.service), which runs without the hermes venv.
HERMES_TELEGRAM__BOT_TOKEN="REPLACE_ME_prod_bot_token"
HERMES_TELEGRAM__CHAT_ID="REPLACE_ME_prod_chat_id"

# --- Slack (rich reports channel) ---
HERMES_SLACK__BOT_TOKEN="xoxb-REPLACE_ME_prod_slack_bot_token"
HERMES_SLACK__DEFAULT_CHANNEL="#hermes-reports"

# --- Healthchecks.io (dead-man's-switch ping) ---
# Pinged by deploy/hermes-health-ping.sh only while hermes.service is active.
HERMES_HEALTHCHECKS__PING_URL="https://hc-ping.com/REPLACE_ME_prod_uuid"
# Optional, one check each (#526). Unset: that timer pings nothing.
# HERMES_HEALTHCHECKS__DAILY_PING_URL="https://hc-ping.com/REPLACE_ME_daily_uuid"
# HERMES_HEALTHCHECKS__ARCHIVE_CHECK_PING_URL="https://hc-ping.com/REPLACE_ME_archive_uuid"

# --- Sentry (error reporting) ---
# HERMES_SENTRY__DSN="https://REPLACE_ME@sentry.example.com/1"
# HERMES_SENTRY__ENVIRONMENT="prod"

# --- Exchange API keys: NOT used in MVP1 ---
# Shadow mode reads public market data and needs no key. No code reads
# these names today. The names match .github/workflows/vps-bootstrap.yml.
# Do NOT use HERMES_BINANCE__API_KEY: the BINANCE config section rejects
# unknown fields, so config load fails and `hermes serve` exits 3.
# HERMES_BINANCE_MAINNET__API_KEY="REPLACE_ME_mainnet_api_key"
# HERMES_BINANCE_MAINNET__API_SECRET="REPLACE_ME_mainnet_api_secret"
# HERMES_BINANCE_TESTNET__API_KEY="REPLACE_ME_testnet_api_key"
# HERMES_BINANCE_TESTNET__API_SECRET="REPLACE_ME_testnet_api_secret"

# --- LLM supervisor (ADR-001 + ADR-005, supervision only) ---
# HERMES_ML__API_KEY="REPLACE_ME_llm_api_key"

# --- Backup (Hetzner Storage Box -> borg) ---
# Not installed in MVP1. See deploy/hetzner-storagebox-setup.md.
# BORG_PASSPHRASE has no HERMES_ prefix, so vps_bootstrap.sh does not
# render it today: add it when the backup unit is installed.
HERMES_BACKUP_BORG_REPO="ssh://u656997@u656997.your-storagebox.de:23/./hermes-backup"
HERMES_BACKUP_SSH_PORT="23"
# BORG_PASSPHRASE="REPLACE_ME_borg_passphrase"
# HERMES_BACKUP_HEALTHCHECK_URL="https://hc-ping.com/REPLACE_ME_backup_uuid"
