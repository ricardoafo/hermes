# Telegram alert for a unit that entered the failed state.
#
# Template unit, started through OnFailure= (hermes.service:
# OnFailure=hermes-notify-failure@%N.service), so %i is the failed unit's name
# without its ".service" suffix and one message goes out per failure. It never restarts: if Telegram is
# unreachable the failure stays in the journal, and the missed healthchecks.io
# ping (hermes-health.service) is the second, independent alert path.
#
# The script runs from /opt/hermes/bin, NOT from the release under
# /opt/hermes/current: a missing or broken release is the likeliest reason
# hermes.service fails, and the alert must survive it (#364). vps_bootstrap.sh
# installs it before any release exists; install_release.sh refreshes it only
# after a release passes its health gate. It needs only bash and curl.
#
# Manual test on the VPS (sends a real message):
#   sudo systemctl start hermes-notify-failure@hermes.service

[Unit]
Description=Telegram alert: %i entered failed state
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=hermes
Group=hermes

# Read by systemd as root before dropping to User=hermes, so the secrets file
# stays root-only. No leading "-": a missing file must fail the alert loudly.
EnvironmentFile=/etc/hermes/env.production
# Read access to the system journal, for the log tail in the message.
SupplementaryGroups=systemd-journal
ExecStart=/bin/bash /opt/hermes/bin/hermes-notify-failure.sh %i.service
TimeoutStartSec=60s

# Hardening — same pattern as the other hermes units.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
CapabilityBoundingSet=
ReadWritePaths=
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0027
