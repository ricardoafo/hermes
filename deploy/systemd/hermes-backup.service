# Nightly borg backup of L2 Parquet + SQLite DBs → Hetzner Storage Box.
#
# The vps-bootstrap workflow installs this file to /etc/systemd/system but
# leaves hermes-backup.timer disabled until the borg repo exists. After the
# prerequisites below, on the VPS:
#   systemctl enable --now hermes-backup.timer
#
# The backup script ships inside each release, so ExecStart follows the
# `current` symlink.
#
# Prerequisites: see deploy/hetzner-storagebox-setup.md for one-time
# borg repo init + Storage Box SSH key upload.

[Unit]
Description=Hermes nightly backup (L2 + SQLite → Hetzner Storage Box)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=hermes
Group=hermes
WorkingDirectory=/var/lib/hermes
EnvironmentFile=/etc/hermes/env.production
ExecStart=/opt/hermes/current/deploy/hermes-backup.sh

# Hardening — same pattern as hermes.service.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hermes

# Backups can take several minutes on cold-cache runs; give room but cap.
TimeoutStartSec=30min

[Install]
WantedBy=multi-user.target
