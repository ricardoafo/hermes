# Fire hermes-health.service every 5 minutes.
#
# Chosen frequency: the healthchecks.io check expects a ping every 5 min with
# a 10 min grace period, so hermes being down alerts after about 15 min of
# silence and a single missed ping never does. See deploy/README.md,
# "Alerting when hermes is down".

[Unit]
Description=Fire hermes-health every 5 minutes
Requires=hermes-health.service

[Timer]
# First ping 2 min after boot, gives the network a moment.
OnBootSec=2min
# Then every 5 min after the last completion.
OnUnitActiveSec=5min
# Run a missed tick on next boot.
Persistent=true
# Small jitter to avoid clock-tick pile-ups.
RandomizedDelaySec=30
Unit=hermes-health.service

[Install]
WantedBy=timers.target
