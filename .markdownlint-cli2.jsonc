{
  "config": {
    "default": true,
    "MD013": false,
    "MD004": { "style": "dash" },
    "MD024": { "siblings_only": true },
    "MD033": false,
    "MD041": true,
    "MD046": { "style": "fenced" }
  },
  "globs": ["**/*.md"],
  "ignores": [
    "node_modules/**",
    ".venv/**",
    ".idea/**",
    ".git/**"
  ]
}
