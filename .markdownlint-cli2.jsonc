{
  "config": {
    "default": true,
    "MD013": false,
    "MD004": { "style": "dash" },
    "MD024": { "siblings_only": true },
    "MD033": false,
    "MD041": true,
    "MD046": { "style": "fenced" }
  },
  "globs": ["**/*.md"],
  "ignores": [
    "node_modules/**",
    ".venv/**",
    ".idea/**",
    ".git/**",
    // Sub-agent worktree scratch — never linted, never committed.
    // Sub-agents spawned via `isolation: worktree` land under
    // `.claude/worktrees/agent-*/` and often leave transient .md files
    // (changelog fragments, PR-body drafts). These are gitignored
    // via `.claude/*` in .gitignore (skills and settings.json excepted); ignore them here too so
    // `markdownlint-cli2` doesn't scan into leftover worktree dirs.
    ".claude/worktrees/**",
    // Transient PR-body scratchpads (drift-eval 2026-08-22, wave 3):
    // sub-agents sometimes write `.pr-body-*.md` at repo root before
    // handing off to create-pr.sh. Those files start with `## Summary`
    // (H2) per the pull_request_template, which trips MD041. create-pr.sh
    // now copies repo-relative body files to /tmp/ automatically; this
    // ignore is belt-and-suspenders for the (disallowed) path where
    // someone bypasses the wrapper.
    "**/.pr-body-*.md",
    ".pr-body-*.md",
    // Changelog fragments (drift-eval 2026-08-22, wave 4): each file under
    // changelog.d/ is a single Markdown bullet — no H1 by design.
    // README.md in that directory IS a full document and is NOT ignored.
    "changelog.d/[0-9]*.md",
    "changelog.d/+*.md",
    "changelog.d/wave-*.md"
  ]
}
