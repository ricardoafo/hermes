# ============================================================
# hermes environment variables — copy to .env.local for dev
# ============================================================
# .env.local is gitignored. NEVER commit real secrets.
# In prod, these values live in /etc/hermes/env.production loaded by systemd
# (see deploy/systemd/hermes.env.example). In CI, they come from
# GH Actions secrets.
#
# Naming convention: HERMES_<SECTION>__<FIELD> — double underscore
# is the nested-delimiter for pydantic-settings-style overrides
# (see docs/architecture/adr-003-solution-architecture and
# docs/decisions/2026-08-23-credential-storage-layered-by-env.md).

# --- Core (runtime tier gates) ---
# Runtime tier — one of dev | sandbox | prod.
# Adapters that touch mainnet money reject dev + sandbox at import time
# (see src/hermes/infrastructure/env_gate.py).
HERMES_ENV=dev
# Belt-and-suspenders kill switch for mainnet exchange endpoints. May
# only be set in prod env; the composite config raises a validation
# error otherwise. Leave commented out for dev + sandbox.
# HERMES_ALLOW_MAINNET=no
# Shadow-mode flag (planned in #175). When true (default for MVP1),
# adapter WRITE methods (place_order, cancel_order) short-circuit +
# emit TradeExecuted events with shadow=true — full pipeline runs
# against real market data WITHOUT touching real orders. Flipping to
# false in MVP2 = real money; requires ENV=prod + ALLOW_MAINNET=yes
# (three-gate rule). Default true; only explicitly false for MVP2.
# HERMES_SHADOW=true

# --- Telegram (urgent alerts channel) ---
# Get bot token from @BotFather. Get chat_id by messaging the bot and
# then hitting https://api.telegram.org/bot<TOKEN>/getUpdates.
HERMES_TELEGRAM__BOT_TOKEN=your-bot-token-here
HERMES_TELEGRAM__CHAT_ID=-100xxxxxxxxxx
# Optional: point Telegram at a loopback fake (http only on loopback).
# HERMES_TELEGRAM__API_BASE=http://127.0.0.1:8081

# --- Slack (rich reports channel) ---
# Bot user OAuth token (starts with "xoxb-") — create at
# https://api.slack.com/apps -> OAuth & Permissions.
# Default channel accepts either "#name" or "C0123456789" channel-id.
HERMES_SLACK__BOT_TOKEN=xoxb-your-token-here
HERMES_SLACK__DEFAULT_CHANNEL=#hermes-reports
# Optional: point Slack at a loopback fake (http only on loopback).
# HERMES_SLACK__API_BASE=http://127.0.0.1:8082

# --- Binance TESTNET (spot exchange — shadow-safe development) ---
# Testnet keys from https://testnet.binance.vision/ (GitHub sign-in,
# FREE, no KYC). Used in HERMES_ENV=dev + sandbox for real-shaped
# integration testing against Binance's testnet infrastructure.
HERMES_BINANCE_TESTNET__API_KEY=your-testnet-api-key
HERMES_BINANCE_TESTNET__API_SECRET=your-testnet-api-secret

# --- Binance MAINNET (real prices — writes gated by HERMES_SHADOW) ---
# Real Binance account API keys (requires ARG-KYC completed).
# Get from https://binance.com → Account → API Management.
# Permissions: enable ONLY "Enable Reading" for MVP1 shadow mode;
# explicitly do NOT enable "Enable Spot & Margin Trading" until MVP2.
# Reads real market data even in shadow mode; writes short-circuit at
# the ShadowGate boundary (#175). Loaded ONLY when HERMES_ENV=prod.
# HERMES_BINANCE_MAINNET__API_KEY=your-mainnet-api-key
# HERMES_BINANCE_MAINNET__API_SECRET=your-mainnet-api-secret

# --- Kraken (second spot venue — TBD product URL) ---
# Two possible sources depending on Kraken product operator has:
#   Scenario A: Kraken Futures Demo (demo-futures.kraken.com) →
#     defer to MVP2 (leveraged futures out of MVP1 scope)
#   Scenario B: Kraken mainnet (kraken.com or pro.kraken.com) →
#     API key from https://www.kraken.com/u/security/api
#     Same shadow-mode gate as Binance mainnet; MVP1 shadow-safe.
# HERMES_KRAKEN__API_KEY=your-kraken-api-key
# HERMES_KRAKEN__API_SECRET=your-kraken-private-key

# --- Frankfurter (FX rates — public, no key required) ---
# Placeholder for a future override; the public endpoint is keyless.
# HERMES_FRANKFURTER__BASE_URL=https://api.frankfurter.dev/v1

# --- Ledger (SQLite persistence — path override) ---
# Default: config/ledger.yaml resolves to ./var/hermes/ledger.db (dev)
# or /var/lib/hermes/ledger.db (prod). Override here only for one-off
# local experiments (e.g. isolated test dbs, alternate mount points).
# See src/hermes/adapters/ledger/ + config/ledger.yaml.
# HERMES_LEDGER__DB_PATH=./var/hermes/ledger.db

# --- Healthchecks.io (dead-man's-switch ping) ---
# Ping URL from your Healthchecks.io project — one UUID per environment.
# HERMES_HEALTHCHECKS__PING_URL=https://hc-ping.com/00000000-0000-0000-0000-000000000000

# --- Sentry (error reporting — planned) ---
# DSN from your Sentry project (Settings -> Client Keys).
# HERMES_SENTRY__DSN=https://public@sentry.example.com/1
# Environment tag for the Sentry event — often mirrors HERMES_ENV.
# HERMES_SENTRY__ENVIRONMENT=dev

# --- LLM supervisor (ADR-001 + ADR-005 — supervision only, never signals) ---
# API key for the supervisor model (Anthropic / OpenAI / etc.). The
# concrete adapter chooses which var it reads — placeholder shape.
# HERMES_ML__API_KEY=your-anthropic-or-openai-api-key
# Optional overrides for model / temperature / kill-switch — usually
# managed via config/ml.yaml; override here only for local experiments.
# HERMES_ML__SUPERVISOR_MODEL=claude-sonnet-4-7
# HERMES_ML__TEMPERATURE=0.2
# HERMES_ML__ENABLED=true
