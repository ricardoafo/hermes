# ============================================================
# hermes environment variables — copy to .env.local for dev
# ============================================================
# .env.local is gitignored. NEVER commit real secrets.
# In prod, these values live in /etc/hermes/env.production loaded by systemd
# (see deploy/systemd/hermes.env.example). In CI, they come from
# GH Actions secrets.
#
# Naming convention: HERMES_<SECTION>__<FIELD> — double underscore
# is the nested-delimiter for pydantic-settings-style overrides
# (see docs/architecture/adr-003-solution-architecture and
# docs/decisions/2026-08-23-credential-storage-layered-by-env.md).

# --- Core (runtime tier gates) ---
# Runtime tier — one of dev | sandbox | prod.
# Adapters that touch mainnet money reject dev + sandbox at import time
# (see src/hermes/infrastructure/env_gate.py).
HERMES_ENV=dev
# Belt-and-suspenders kill switch for mainnet exchange endpoints. May
# only be set in prod env; the composite config raises a validation
# error otherwise. Leave commented out for dev + sandbox.
# HERMES_ALLOW_MAINNET=no
#
# What gates real orders today (all three, checked together by
# src/hermes/infrastructure/mainnet_permit.py): HERMES_ENV set to prod,
# HERMES_ALLOW_MAINNET set to yes, and a stored LIVE_APPROVED certification for the
# strategy with unchanged parameters. A trading adapter without that permit
# cannot place or cancel orders. MVP1 sends none: it reads public market data.

# --- Telegram (urgent alerts channel) ---
# Get bot token from @BotFather. Get chat_id by messaging the bot and
# then hitting https://api.telegram.org/bot<TOKEN>/getUpdates.
HERMES_TELEGRAM__BOT_TOKEN=your-bot-token-here
HERMES_TELEGRAM__CHAT_ID=-100xxxxxxxxxx

# --- Slack (rich reports channel) ---
# Bot user OAuth token (starts with "xoxb-") — create at
# https://api.slack.com/apps -> OAuth & Permissions.
# Default channel accepts either "#name" or "C0123456789" channel-id.
HERMES_SLACK__BOT_TOKEN=xoxb-your-token-here
HERMES_SLACK__DEFAULT_CHANNEL=#hermes-reports

# --- Binance read-only key for `hermes reconcile` (#29) ---
# Read only while HERMES_ALLOW_MAINNET is yes. Create a separate key with the
# "Enable Reading" permission only, restricted to the host's IP. Never reuse a
# trading key. MVP1 shadow mode needs no exchange key at all.
# HERMES_BINANCE_READ__API_KEY=your-read-only-api-key
# HERMES_BINANCE_READ__API_SECRET=your-read-only-api-secret

# --- Kraken (read-only key for the fee-schedule contract test) ---
# Only tests/contract/test_kraken_public_fees.py and the scheduled contract
# run read these. Use a key with query permissions only.
# HERMES_KRAKEN__API_KEY=your-kraken-api-key
# HERMES_KRAKEN__API_SECRET=your-kraken-private-key

# --- Frankfurter (FX rates — public, no key required) ---
# Placeholder for a future override; the public endpoint is keyless.
# HERMES_FRANKFURTER__BASE_URL=https://api.frankfurter.dev/v1

# --- Healthchecks.io (dead-man's-switch ping) ---
# Ping URL from your Healthchecks.io project — one UUID per environment.
# HERMES_HEALTHCHECKS__PING_URL=https://hc-ping.com/00000000-0000-0000-0000-000000000000

# --- Sentry (error reporting) ---
# DSN from your Sentry project (Settings -> Client Keys).
# HERMES_SENTRY__DSN=https://public@sentry.example.com/1
# Environment tag for the Sentry event — often mirrors HERMES_ENV.
# HERMES_SENTRY__ENVIRONMENT=dev
