# .env is OPTIONAL for the default on-demand flow — up.sh fetches a fresh
# RUNNER_TOKEN via `gh api` per session. Nothing needs to live on disk.
#
# Only create .env if you want the long-lived PAT flow for 24/7 loops:
#
#   RUNNER_REGISTRATION_PAT=github_pat_your_token_here
#
# PAT requirements (fine-grained):
#   - Repository access: ricardoafo/hermes only
#   - Repository permissions: Administration = Read and write
#
# .env is gitignored by the repo root `.gitignore` (the `.env` pattern
# excludes it at every path). Verify before you write anything sensitive.
#
# You may also override the target repo if you reuse the same image for
# another project:
#
#   RUNNER_REPOSITORY=some-owner/some-repo

RUNNER_REPOSITORY=ricardoafo/hermes
# RUNNER_REGISTRATION_PAT=github_pat_replace_me
