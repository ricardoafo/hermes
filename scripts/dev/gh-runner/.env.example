# Copy this file to `.env` in this directory and fill in the values.
# The `.env` file is gitignored by the repo root .gitignore.
#
# ONE variable is REQUIRED for 24/7 operation:
#
#   RUNNER_REGISTRATION_PAT — a fine-grained GitHub Personal Access Token
#     with these permissions:
#       * Repository access: ricardoafo/hermes only (single-repo scope)
#       * Repository permissions:
#           - Administration: Read and write     ← REQUIRED
#           - Metadata: Read (auto-selected)
#     Create at: https://github.com/settings/personal-access-tokens/new
#     Set an expiration (90 days recommended; renew via Dependabot-like
#     reminder in your calendar).
#
# TWO optional overrides:
#
#   RUNNER_REPOSITORY — target repo, format owner/repo. Default:
#     ricardoafo/hermes. Override if you're reusing this same runner
#     directory for a different repo.
#
#   RUNNER_TOKEN — pre-fetched 1-hour registration token. Used only for
#     ad-hoc troubleshooting when you don't want to store a PAT. Not
#     compatible with 24/7 restart (tokens expire mid-loop). Leave
#     unset in normal operation.
#
# --- copy from here down into your .env file, then fill in ---

RUNNER_REPOSITORY=ricardoafo/hermes
RUNNER_REGISTRATION_PAT=github_pat_replace_me
