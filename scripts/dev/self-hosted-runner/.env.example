# Copy to .env (gitignored) and fill in.
#
# RUNNER_REGISTRATION_PAT — fine-grained personal access token with:
#   - Repository access: ricardoafo/hermes only
#   - Repository permissions: Administration = Read and write
# Never commit the real .env file. .gitignore excludes .env at the repo root
# but this dir's .env is under scripts/dev/self-hosted-runner/ — verify it's
# also gitignored (the *.env pattern covers it).

RUNNER_REPOSITORY=ricardoafo/hermes
RUNNER_REGISTRATION_PAT=github_pat_xxx_replace_me
